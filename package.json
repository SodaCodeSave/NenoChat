{
  "name": "nenochat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nenochat/server --filter @nenochat/desktop dev",
    "dev:server": "pnpm --filter @nenochat/server dev",
    "dev:web": "pnpm --filter @nenochat/desktop dev",
    "dev:app": "pnpm --filter @nenochat/desktop tauri:dev",
    "dev:admin": "pnpm --filter @nenochat/admin dev",
    "build:server": "pnpm --filter @nenochat/server typecheck",
    "build:web": "pnpm --filter @nenochat/desktop build",
    "build:app": "pnpm --filter @nenochat/desktop tauri:build",
    "build:admin": "pnpm --filter @nenochat/admin build",
    "build:integrated:server": "node scripts/build-integrated-server.mjs",
    "build:app:integrated": "pnpm build:integrated:server && pnpm --filter @nenochat/desktop tauri build --config src-tauri/tauri.integrated.conf.json",
    "version:print": "node scripts/version.mjs",
    "version:sync": "node scripts/sync-package-version.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test"
  }
}
