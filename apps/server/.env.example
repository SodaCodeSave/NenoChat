# 监听
HOST=0.0.0.0
PORT=8787

# 对外地址，用于拼装附件 URL；自建部署时改成你的域名
PUBLIC_BASE_URL=http://localhost:8787

# 数据目录（SQLite 与上传文件都在这里）
DATA_DIR=./data

# 必改：JWT 签名密钥与 AI 密钥加密密钥，至少 16 位
JWT_SECRET=please-change-this-jwt-secret
SECRET_KEY=please-change-this-aes-secret

# 注册策略：open 开放注册 / invite 需要邀请码 / closed 关闭注册
REGISTRATION_MODE=open

SERVER_NAME=NenoChat
LOG_LEVEL=info

# 允许跨域的来源，逗号分隔；* 表示全部（Web 版客户端需要）
CORS_ORIGINS=*
