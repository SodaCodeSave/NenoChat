{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NenoChat",
  "version": "0.1.0",
  "identifier": "com.nenochat.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NenoChat",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:nenochat.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["nenochat"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3NzAwMzdCREZDN0RGRkIKUldUNzM4ZmZld053UjNFa2V6M3VZckZzUDNxYzhNS1hKUHBtVHVHZmZ1eGxwSTJKaC8zYzVUdG0K",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/SodaCodeSave/NenoChat/releases/latest/download/latest.json",
        "https://github.com/SodaCodeSave/NenoChat/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
