{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NenoChat 主窗口所需能力",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "opener:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close",
    "store:default",
    "notification:default",
    "dialog:default",
    "fs:default"
  ]
}
